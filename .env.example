# Environment variables for laundry app
# Copy this to .env locally and set the same secrets in Netlify environment variables.

# Supabase project URL and publishable/anon key
SUPABASE_URL=your-supabase-project-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase service role key for Netlify Edge Functions only. Never expose this in browser files.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret pepper used to hash OTPs and rate-limit IPs.
OTP_PEPPER=replace-with-a-long-random-secret
RATE_LIMIT_PEPPER=replace-with-a-different-long-random-secret

# Resend email provider settings for admin OTP delivery.
# The invitation endpoint refuses to run without this secret.
RESEND_API_KEY=replace-with-a-new-resend-api-key
OTP_EMAIL_FROM="Idojuan Laundry <admin@your-domain.com>"

# Public site URL used in invitation emails.
URL=https://your-netlify-site.netlify.app

# Port for local Node-style API experiments, optional.
PORT=3000
